# MyCTF production settings. Copy to .env.prod and change EVERY value marked CHANGE.
# Never commit .env.prod.

MYCTF_ENV=production

# CHANGE: random 64+ chars. Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
MYCTF_SECRET_KEY=CHANGE_ME

# CHANGE: password of the bootstrap admin account (created on first start).
MYCTF_ADMIN_USER=admin
MYCTF_ADMIN_EMAIL=admin@example.com
MYCTF_ADMIN_PASSWORD=CHANGE_ME

# CHANGE: random value, also entered in Cloudflare Pages as ORIGIN_SECRET.
# Requests without it are rejected, so nobody can bypass the Cloudflare proxy.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MYCTF_ORIGIN_SECRET=CHANGE_ME

# CHANGE: your public site address(es), comma separated, no trailing slash. Browsers
# may only make changes (login, submit flag...) from these origins (CSRF protection).
MYCTF_ALLOWED_ORIGINS=https://ctf.example.com

# Served over HTTPS by Cloudflare -> mark the session cookie Secure.
MYCTF_COOKIE_SECURE=1
# Behind Cloudflare: trust forwarded client IPs (needed for rate limiting).
MYCTF_TRUST_PROXY=1
# Returns reset links in API responses (local testing only). MUST stay off on a public site.
MYCTF_EXPOSE_DEV_LINKS=0

# --- Email: sign-in codes and password-reset links (see docs/DEPLOYMENT.md, "Email") ---
# CHANGE: your provider's SMTP server. Once MYCTF_SMTP_HOST is set, every sign-in asks
# for a 6-digit code sent to the account's email (MYCTF_LOGIN_EMAIL_OTP=auto).
MYCTF_SMTP_HOST=smtp.example.com
MYCTF_SMTP_PORT=587
# starttls (port 587) or ssl (port 465)
MYCTF_SMTP_SECURITY=starttls
MYCTF_SMTP_USER=CHANGE_ME
MYCTF_SMTP_PASSWORD=CHANGE_ME
MYCTF_MAIL_FROM=MyCTF <no-reply@ctf.example.com>
# Links in emails point here (defaults to the first MYCTF_ALLOWED_ORIGINS entry).
MYCTF_PUBLIC_URL=https://ctf.example.com
# auto = codes at sign-in when SMTP is set, 1 = always, 0 = off
MYCTF_LOGIN_EMAIL_OTP=auto

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels -> your tunnel).
TUNNEL_TOKEN=CHANGE_ME

# Optional: ceiling on requests per IP per minute across all endpoints (0 = off).
# Lower it if you are being scraped; raise it for a big class behind one address.
# MYCTF_RL_GLOBAL=1200
