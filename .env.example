# Copy to .env and adjust. The dev app runs with safe defaults if unset, EXCEPT
# you should always set a real secret key outside local development.

# REQUIRED in any shared/production environment — sign tokens & hash flags.
# python3 -c "import secrets; print(secrets.token_hex(32))"
MYCTF_SECRET_KEY=

# Database (dev uses SQLite at this path; prod uses a Postgres DSN).
MYCTF_DB_PATH=instance/myctf.sqlite3

# Bootstrap administrator (created on first run if missing).
MYCTF_ADMIN_USER=admin
MYCTF_ADMIN_EMAIL=admin@myctf.local
# Leave empty locally: a random password is generated and printed on first start.
MYCTF_ADMIN_PASSWORD=

# Sessions & labs
MYCTF_SESSION_TTL=43200          # 12h
MYCTF_LAB_TTL=2700               # 45m before a lab instance auto-expires
MYCTF_LAB_MAX_PER_USER=6

# Password hashing cost (PBKDF2 iterations)
MYCTF_PBKDF2_ITERS=600000

# Rate limits (per window seconds)
MYCTF_RL_WINDOW=60
MYCTF_RL_FLAG=20
MYCTF_RL_LOGIN=10

# Dev server
PORT=8000
MYCTF_DEBUG=

# Local dev only: return reset/verify links in API responses (there is no mailer).
# Never enable on a public site.
# MYCTF_EXPOSE_DEV_LINKS=1
