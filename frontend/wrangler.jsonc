{
  "name": "myctf",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-14",
  "vars": { "ORIGIN_URL": "https://api.myctf.app" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin/api/*", "/labs/*"]
  },
  "keep_vars": true
}
