{
  // Cloudflare Workers config: static React app + API proxy (worker/index.ts).
  "name": "myctf",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./dist",
    // Unknown paths (e.g. /challenges/xyz on refresh) get index.html: client-side routing.
    "not_found_handling": "single-page-application",
    // Only these paths run the Worker (the API proxy). Everything else is a static file.
    "run_worker_first": ["/api/*", "/admin/api/*", "/labs/*"]
  },
  // ORIGIN_URL / ORIGIN_SECRET are set in the dashboard (Settings -> Variables and
  // secrets). Without this, every deploy would wipe them.
  "keep_vars": true
}
